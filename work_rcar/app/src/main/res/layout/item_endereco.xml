<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    app:cardBackgroundColor="#0C1419"
    app:cardCornerRadius="16dp"
    app:cardElevation="0dp">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical">
            <TextView
                android:id="@+id/iconEndereco"
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:gravity="center"
                android:text="⌖"
                android:textColor="#FFFFFF"
                android:textSize="25sp"
                android:background="@drawable/bg_category" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="12dp">
                <TextView
                    android:id="@+id/txtTituloEndereco"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Casa"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"
                    android:textSize="15sp" />

                <TextView
                    android:id="@+id/txtDetalheEndereco"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Rua Exemplo, 123 - Centro\nSão Paulo - SP | CEP 01000-000"
                    android:textColor="#AEB8BE"
                    android:textSize="12sp"
                    android:layout_marginTop="3dp" />
            </LinearLayout>

            <TextView
                android:id="@+id/btnMenuEndereco"
                android:layout_width="34dp"
                android:layout_height="40dp"
                android:gravity="center"
                android:text="⋮"
                android:textColor="#FFFFFF"
                android:textSize="24sp"
                android:clickable="true" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#24333B"
            android:layout_marginTop="10dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:gravity="center">
            <TextView
                android:id="@+id/btnEditarEndereco"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:text="✎  Editar"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:clickable="true" />

            <TextView
                android:id="@+id/btnExcluirEndereco"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:text="▢  Excluir"
                android:textColor="#FF6B6B"
                android:textSize="12sp"
                android:clickable="true" />

            <TextView
                android:id="@+id/btnUsarEndereco"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:text="✓  Usar"
                android:textColor="#FF9A26"
                android:textSize="12sp"
                android:clickable="true" />
        </LinearLayout>
    </LinearLayout>
</androidx.cardview.widget.CardView>
