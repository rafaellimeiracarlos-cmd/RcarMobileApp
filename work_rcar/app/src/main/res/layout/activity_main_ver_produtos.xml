<?xml version='1.0' encoding='UTF-8'?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/rootDetalheProduto" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="#070809">

    <!-- Cabeçalho premium da loja -->
    <LinearLayout android:id="@+id/headerMercadoLivre" android:layout_width="match_parent" android:layout_height="58dp" android:gravity="center_vertical" android:orientation="horizontal" android:paddingStart="12dp" android:paddingEnd="14dp" android:background="#08090A">
        <ImageView android:id="@+id/btnVoltarinicial" android:layout_width="30dp" android:layout_height="30dp" android:padding="3dp" android:src="@drawable/btnvoltar" android:contentDescription="Voltar" android:tint="#FF7A00"/>
        <ImageView android:id="@+id/imgLogoDetalhe" android:layout_width="0dp" android:layout_height="44dp" android:layout_weight="1" android:layout_marginStart="8dp" android:layout_marginEnd="8dp" android:scaleType="fitCenter" android:src="@drawable/logo_rcar_header" android:contentDescription="Logo RCarPremium"/>
        <ImageView android:id="@+id/btnCarrinhoTopo" android:layout_width="32dp" android:layout_height="32dp" android:padding="2dp" android:src="@drawable/carrinhocompras" android:contentDescription="Abrir carrinho" android:tint="#FF7A00"/>
    </LinearLayout>

    <!-- Pesquisa -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="42dp" android:layout_marginStart="16dp" android:layout_marginEnd="16dp" android:layout_marginBottom="8dp" android:orientation="horizontal" android:gravity="center_vertical" android:paddingStart="12dp" android:paddingEnd="8dp" android:background="@drawable/bg_detail_search">
        <ImageView android:layout_width="20dp" android:layout_height="20dp" android:src="@android:drawable/ic_menu_search" android:tint="#AEB5C0" android:contentDescription="Pesquisar"/>
        <EditText android:id="@+id/editPesquisaDetalhe" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_marginStart="8dp" android:background="@android:color/transparent" android:hint="Buscar peças e acessórios..." android:singleLine="true" android:imeOptions="actionSearch" android:textColor="#F7F7F7" android:textColorHint="#8C929B" android:textSize="13sp" android:padding="0dp"/>
    </LinearLayout>

    <TextView android:id="@+id/txtBannerPromocional" android:layout_width="match_parent" android:layout_height="30dp" android:gravity="center" android:background="#211205" android:text="⚡  OFERTAS RCarPremium  •  CONFIRA CONDIÇÕES DE FRETE" android:textColor="#FF9A28" android:textStyle="bold" android:textSize="10sp" android:letterSpacing="0.02"/>

    <!-- Todo o conteúdo abaixo rola junto, inclusive produtos relacionados -->
    <ScrollView android:id="@+id/scrollDetalheProduto" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:fillViewport="false" android:clipToPadding="false" android:scrollbars="vertical" android:paddingBottom="12dp">
        <LinearLayout android:id="@+id/conteudoDetalheProduto" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">

            <FrameLayout android:layout_width="match_parent" android:layout_height="242dp" android:layout_marginStart="16dp" android:layout_marginEnd="16dp" android:layout_marginTop="14dp" android:background="@drawable/bg_product_hero" android:padding="1dp">
                <ImageView android:id="@+id/imgProdutoDetalhe" android:clickable="true" android:focusable="true" android:layout_width="match_parent" android:layout_height="match_parent" android:background="#101113" android:padding="8dp" android:scaleType="fitCenter" android:src="@drawable/pecasautomotiva" android:contentDescription="Galeria do produto. Toque nas laterais para trocar de foto ou no centro para ampliar"/>
                <TextView android:id="@+id/txtSeloProduto" android:layout_width="wrap_content" android:layout_height="30dp" android:layout_gravity="top|start" android:layout_margin="10dp" android:gravity="center" android:paddingStart="12dp" android:paddingEnd="12dp" android:background="@drawable/bg_product_badge" android:text="PEÇA AUTOMOTIVA" android:textColor="#FFFFFF" android:textSize="10sp" android:textStyle="bold"/>
                <TextView android:id="@+id/btnFavoritoDetalhe" android:layout_width="36dp" android:layout_height="36dp" android:layout_gravity="top|end" android:layout_margin="10dp" android:gravity="center" android:background="@drawable/bg_product_outline_button" android:text="♡" android:textColor="#FFFFFF" android:textSize="22sp" android:contentDescription="Favoritar produto"/>
                <TextView android:id="@+id/txtIndicadorGaleria" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="bottom|center_horizontal" android:layout_marginBottom="8dp" android:background="#B5000000" android:paddingStart="9dp" android:paddingEnd="9dp" android:paddingTop="4dp" android:paddingBottom="4dp" android:text="●  ○  ○  ○" android:textColor="#FF8A00" android:textSize="13sp"/>
            </FrameLayout>
            <TextView android:id="@+id/txtDicaGaleria" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginStart="16dp" android:layout_marginEnd="16dp" android:layout_marginTop="7dp" android:gravity="center" android:text="‹  Toque nas laterais para trocar  •  centro para ampliar  ›" android:textColor="#9EA4AD" android:textSize="10sp"/>

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginStart="18dp" android:layout_marginEnd="18dp" android:layout_marginTop="16dp" android:orientation="vertical">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="NOVO  •  LINHA AUTOMOTIVA" android:textColor="#9CA3AF" android:textSize="10sp" android:letterSpacing="0.08"/>
                <TextView android:id="@+id/txtNomeProdutoDetalhe" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:text="Pastilha de Freio RCar" android:textColor="#FFFFFF" android:textSize="23sp" android:textStyle="bold" android:maxLines="3"/>
                <TextView android:id="@+id/txtVendedorProdutoDetalhe" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="7dp" android:text="Vendido por RCarPremium" android:textColor="#FF7900" android:textSize="12sp" android:textStyle="bold"/><TextView android:id="@+id/txtRatingDetalhe" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="★ ★ ★ ★ ★   Destaque RCarPremium" android:textColor="#FF9A22" android:textSize="12sp"/>
            </LinearLayout>

            <!-- Preço e condições -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginStart="16dp" android:layout_marginEnd="16dp" android:layout_marginTop="14dp" android:orientation="vertical" android:padding="16dp" android:background="@drawable/bg_detail_card">
                <TextView android:id="@+id/txtPrecoAntigo" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="R$ 189,90" android:textColor="#8A8D93" android:textSize="13sp" android:visibility="gone"/>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
                    <TextView android:id="@+id/txtPrecoProdutoDetalhe" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="R$ 150,00" android:textColor="#FF7A00" android:textSize="31sp" android:textStyle="bold"/>
                    <TextView android:id="@+id/txtDescontoDetalhe" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="10dp" android:paddingStart="10dp" android:paddingEnd="10dp" android:paddingTop="5dp" android:paddingBottom="5dp" android:background="@drawable/bg_product_badge" android:text="OFERTA" android:textColor="#FFFFFF" android:textSize="11sp" android:textStyle="bold" android:visibility="gone"/>
                </LinearLayout>
                <TextView android:id="@+id/txtParcelamento" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="Em até 3x sem juros" android:textColor="#E5E7EB" android:textSize="13sp"/>
                <TextView android:id="@+id/txtTotalSelecionado" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="Total do item: R$ 150,00" android:textColor="#B8BDC5" android:textSize="12sp"/>
            </LinearLayout>

            <!-- Consulta de entrega: expansão abaixo do resumo, mantendo estilo preto e laranja -->
            <LinearLayout android:id="@+id/cardConsultaEntrega" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginStart="16dp" android:layout_marginEnd="16dp" android:layout_marginTop="10dp" android:orientation="vertical" android:background="@drawable/bg_detail_card">
                <LinearLayout android:id="@+id/btnExpandirEntrega" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="62dp" android:orientation="horizontal" android:gravity="center_vertical" android:paddingStart="13dp" android:paddingEnd="13dp" android:paddingTop="8dp" android:paddingBottom="8dp" android:clickable="true" android:focusable="true" android:contentDescription="Consultar prazo e frete pelo CEP">
                    <TextView android:layout_width="38dp" android:layout_height="38dp" android:gravity="center" android:text="🚚" android:textSize="21sp"/>
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="8dp" android:orientation="vertical">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Entrega para seu endereço" android:textColor="#FF9A22" android:textSize="13sp" android:textStyle="bold"/>
                        <TextView android:id="@+id/txtResumoEntrega" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="Digite seu CEP para consultar a região e as condições de entrega" android:textColor="#B5BBC4" android:textSize="11sp"/>
                    </LinearLayout>
                    <TextView android:id="@+id/iconeExpandirEntrega" android:layout_width="28dp" android:layout_height="wrap_content" android:gravity="center" android:text="⌄" android:textColor="#FF9A22" android:textSize="23sp"/>
                </LinearLayout>
                <LinearLayout android:id="@+id/conteudoConsultaEntrega" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="14dp" android:paddingEnd="14dp" android:paddingBottom="15dp" android:visibility="gone">
                    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#46331F" android:layout_marginBottom="13dp"/>
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Consulte o CEP da entrega" android:textColor="#FFFFFF" android:textSize="13sp" android:textStyle="bold"/>
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="9dp" android:orientation="horizontal" android:gravity="center_vertical">
                        <EditText android:id="@+id/editCepEntrega" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:layout_marginEnd="8dp" android:background="@drawable/bg_detail_search" android:gravity="center_vertical" android:hint="00000-000" android:inputType="number" android:maxLength="9" android:digits="0123456789-" android:singleLine="true" android:paddingStart="12dp" android:paddingEnd="8dp" android:textColor="#FFFFFF" android:textColorHint="#979DA5" android:textSize="14sp"/>
                        <Button android:id="@+id/btnConsultarCep" android:layout_width="wrap_content" android:layout_height="48dp" android:minWidth="0dp" android:minHeight="48dp" android:backgroundTint="#FF7A00" android:text="CONSULTAR" android:textColor="#121212" android:textStyle="bold" android:textSize="11sp" android:textAllCaps="false"/>
                    </LinearLayout>
                    <TextView android:id="@+id/txtResultadoEntrega" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:text="A consulta identifica a região do CEP. Frete e prazo seguem as configurações da loja." android:textColor="#B5BBC4" android:lineSpacingExtra="3dp" android:textSize="12sp" android:accessibilityLiveRegion="polite"/>
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="O prazo informado pela loja é uma previsão, não uma cotação de transportadora. Confira as condições antes de pagar." android:textColor="#8E949C" android:textSize="10sp"/>
                </LinearLayout>
            </LinearLayout>

            <!-- Quantidade -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="56dp" android:layout_marginStart="16dp" android:layout_marginEnd="16dp" android:layout_marginTop="10dp" android:orientation="horizontal" android:gravity="center_vertical" android:paddingStart="14dp" android:paddingEnd="10dp" android:background="@drawable/bg_detail_search">
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Quantidade" android:textColor="#FFFFFF" android:textSize="14sp"/>
                <Button android:id="@+id/btnDiminuirQtd" android:layout_width="42dp" android:layout_height="40dp" android:backgroundTint="#24272B" android:minHeight="0dp" android:minWidth="0dp" android:padding="0dp" android:text="−" android:textColor="#FF7A00" android:textSize="20sp"/>
                <TextView android:id="@+id/txtQuantidadeDetalhe" android:layout_width="42dp" android:layout_height="wrap_content" android:gravity="center" android:text="1" android:textColor="#FFFFFF" android:textSize="15sp" android:textStyle="bold"/>
                <Button android:id="@+id/btnAumentarQtd" android:layout_width="42dp" android:layout_height="40dp" android:backgroundTint="#FF7A00" android:minHeight="0dp" android:minWidth="0dp" android:padding="0dp" android:text="+" android:textColor="#111111" android:textSize="20sp"/>
            </LinearLayout>

            <!-- Selos de serviço -->
            <HorizontalScrollView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:scrollbars="none" android:paddingStart="16dp" android:paddingEnd="16dp">
                <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginEnd="8dp" android:padding="10dp" android:background="@drawable/bg_detail_card" android:text="✓  Atendimento RCar" android:textColor="#E9ECEF" android:textSize="11sp"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginEnd="8dp" android:padding="10dp" android:background="@drawable/bg_detail_card" android:text="✓  Informações claras" android:textColor="#E9ECEF" android:textSize="11sp"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:padding="10dp" android:background="@drawable/bg_detail_card" android:text="✓  Suporte da loja" android:textColor="#E9ECEF" android:textSize="11sp"/>
                </LinearLayout>
            </HorizontalScrollView>

            <!-- Abas de informação -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginStart="16dp" android:layout_marginEnd="16dp" android:layout_marginTop="18dp" android:orientation="horizontal" android:background="@drawable/bg_detail_card">
                <TextView android:id="@+id/tabDescricaoDetalhe" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1.1" android:gravity="center" android:padding="4dp" android:text="Descrição" android:textColor="#FF7A00" android:textStyle="bold" android:textSize="12sp" android:background="@drawable/bg_detail_tab_selected"/>
                <TextView android:id="@+id/tabEspecificacoesDetalhe" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1.2" android:gravity="center" android:padding="4dp" android:text="Especificações" android:textColor="#AEB5C0" android:textSize="12sp"/>
                <TextView android:id="@+id/tabAvaliacoesDetalhe" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:padding="4dp" android:text="Avaliações" android:textColor="#AEB5C0" android:textSize="12sp"/>
            </LinearLayout>
            <TextView android:id="@+id/txtConteudoAbaDetalhe" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginStart="16dp" android:layout_marginEnd="16dp" android:padding="16dp" android:background="@drawable/bg_detail_card" android:lineSpacingExtra="3dp" android:text="Confira as informações do produto para fazer a escolha certa." android:textColor="#C8CDD5" android:textSize="13sp"/>

            <!-- Produtos relacionados: preenchidos pelo Kotlin -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="24dp" android:orientation="vertical">
                <View android:layout_width="4dp" android:layout_height="42dp" android:layout_gravity="start|center_vertical" android:layout_marginStart="16dp" android:background="#FF7A00"/>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:paddingStart="16dp" android:paddingEnd="16dp" android:layout_marginTop="-42dp">
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:paddingStart="12dp">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Produtos relacionados" android:textColor="#FFFFFF" android:textStyle="bold" android:textSize="18sp"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:text="Peças que combinam com sua escolha" android:textColor="#9EA4AD" android:textSize="11sp"/>
                    </LinearLayout>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="EXPLORAR  ›" android:textColor="#FF9A22" android:textStyle="bold" android:textSize="10sp"/>
                </LinearLayout>
                <HorizontalScrollView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:paddingStart="16dp" android:paddingEnd="16dp" android:clipToPadding="false" android:scrollbars="none">
                    <LinearLayout android:id="@+id/relatedProductsContainer" android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal"/>
                </HorizontalScrollView>
            </LinearLayout>

            <Button android:id="@+id/btnVoltarAoTopoDetalhe" android:layout_width="wrap_content" android:layout_height="44dp" android:layout_gravity="center_horizontal" android:layout_marginTop="24dp" android:layout_marginBottom="20dp" android:backgroundTint="#211205" android:text="↑  VOLTAR AO TOPO" android:textColor="#FF9A22" android:textStyle="bold"/>
        </LinearLayout>
    </ScrollView>

    <!-- CTA fixo de compra -->
    <LinearLayout android:id="@+id/footerBotoesCompra" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:paddingStart="10dp" android:paddingEnd="10dp" android:paddingTop="9dp" android:paddingBottom="9dp" android:background="@drawable/bg_floating_checkout" android:layout_marginStart="14dp" android:layout_marginEnd="14dp" android:layout_marginTop="8dp" android:layout_marginBottom="4dp" android:elevation="18dp" android:clipToPadding="false" android:clipChildren="false" android:padding="9dp">
        <Button android:id="@+id/btnAdicionarAoCarrinho" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:layout_marginEnd="6dp" android:background="@drawable/bg_product_outline_button" android:text="🛒  Adicionar" android:textAllCaps="false" android:textColor="#FF8A00" android:textSize="12sp" android:textStyle="bold" android:minHeight="48dp"/>
        <Button android:id="@+id/btnComprarAgora" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:layout_marginStart="6dp" android:background="@drawable/bg_orange_button" android:text="Comprar agora  ›" android:textAllCaps="false" android:textColor="#FFFFFF" android:textSize="12sp" android:textStyle="bold" android:minHeight="48dp"/>
    </LinearLayout>

    <!-- Rodapé de navegação da loja -->
    <include layout="@layout/bottom_nav" android:id="@+id/footerNavDetalhe"/></LinearLayout>
