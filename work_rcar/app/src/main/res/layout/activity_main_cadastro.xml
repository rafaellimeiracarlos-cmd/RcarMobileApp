<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#090A0B"
    android:clipToPadding="false"
    android:fillViewport="true"
    android:overScrollMode="never"
    tools:context=".MainActivityCadastro">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="12dp"
        android:paddingEnd="24dp"
        android:paddingBottom="28dp">

        <ImageView
            android:id="@+id/img_logo"
            android:layout_width="154dp"
            android:layout_height="112dp"
            android:layout_gravity="center_horizontal"
            android:contentDescription="@string/logo_rcarpremium"
            android:scaleType="fitCenter"
            android:src="@drawable/imglogo" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="2dp"
            android:letterSpacing="0.14"
            android:text="RCAR PREMIUM  •  AUTO PEÇAS"
            android:textColor="#FF7A00"
            android:textSize="10sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/textTituloCadastro"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:text="Crie sua conta"
            android:textColor="#FFFFFF"
            android:textSize="28sp"
            android:fontFamily="sans-serif"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="7dp"
            android:gravity="center"
            android:lineSpacingExtra="2dp"
            android:text="Cadastre-se para acompanhar ofertas,\npedidos e novidades da RCAR Premium."
            android:textColor="#A6A6A6"
            android:textSize="14sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:background="@drawable/bg_register_panel"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="NOME COMPLETO"
                android:textColor="#E8E8E8"
                android:textSize="11sp"
                android:letterSpacing="0.08"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/editNomeCadastro"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="8dp"
                android:autofillHints="name"
                android:background="@drawable/bg_register_input"
                android:gravity="center_vertical"
                android:hint="Digite seu nome completo"
                android:inputType="textPersonName|textCapWords"
                android:imeOptions="actionNext"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:singleLine="true"
                android:textColor="#FFFFFF"
                android:textColorHint="#777A80"
                android:textSize="14sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="E-MAIL"
                android:textColor="#E8E8E8"
                android:textSize="11sp"
                android:letterSpacing="0.08"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/editEmailCadastro"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="8dp"
                android:autofillHints="emailAddress"
                android:background="@drawable/bg_register_input"
                android:gravity="center_vertical"
                android:hint="seuemail@exemplo.com"
                android:inputType="textEmailAddress"
                android:imeOptions="actionNext"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:singleLine="true"
                android:textColor="#FFFFFF"
                android:textColorHint="#777A80"
                android:textSize="14sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="SENHA"
                android:textColor="#E8E8E8"
                android:textSize="11sp"
                android:letterSpacing="0.08"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/editSenhaCadastro"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="8dp"
                android:autofillHints="newPassword"
                android:background="@drawable/bg_register_input"
                android:gravity="center_vertical"
                android:hint="Crie uma senha segura"
                android:inputType="textPassword"
                android:imeOptions="actionDone"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:singleLine="true"
                android:textColor="#FFFFFF"
                android:textColorHint="#777A80"
                android:textSize="14sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:drawablePadding="6dp"
                android:text="Use pelo menos 8 caracteres para proteger sua conta."
                android:textColor="#929292"
                android:textSize="11sp" />

            <Button
                android:id="@+id/btnFinalizarCadastro"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="24dp"
                android:background="@drawable/bg_orange_button"
                android:backgroundTint="@null"
                android:elevation="2dp"
                android:fontFamily="sans-serif"
                android:letterSpacing="0.04"
                android:text="CRIAR MINHA CONTA"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold" />

        </LinearLayout>

        <TextView
            android:id="@+id/textVoltarLogin"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:gravity="center"
            android:minHeight="48dp"
            android:padding="8dp"
            android:text="Já tem uma conta? Faça Login"
            android:textColor="#D8D8D8"
            android:textSize="13sp"
            android:textStyle="bold"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:gravity="center"
            android:text="SEU CARRO, NOSSA PRIORIDADE."
            android:textColor="#545454"
            android:textSize="9sp"
            android:letterSpacing="0.12" />

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
