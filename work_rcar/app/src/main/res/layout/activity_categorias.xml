<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#0B0C0E">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:gravity="center_vertical"
        android:paddingStart="12dp"
        android:paddingEnd="16dp"
        android:background="#101113">
        <TextView
            android:id="@+id/btnVoltarCategorias"
            android:layout_width="42dp"
            android:layout_height="match_parent"
            android:gravity="center"
            android:text="‹"
            android:textColor="#FFFFFF"
            android:textSize="34sp"
            android:fontFamily="sans-serif-light"
            android:contentDescription="Voltar"
            android:clickable="true"
            android:focusable="true" />

        <ImageView
            android:layout_width="74dp"
            android:layout_height="42dp"
            android:layout_marginStart="4dp"
            android:src="@drawable/imglogo"
            android:scaleType="fitCenter"
            android:contentDescription="Logo RCAR Premium" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="end">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="CATEGORIAS"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold"
                android:letterSpacing="0.04" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Explore nosso catálogo"
                android:textColor="#8F9298"
                android:textSize="10sp" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="16dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/bg_category_search"
        android:paddingStart="15dp"
        android:paddingEnd="14dp">
        <TextView
            android:layout_width="28dp"
            android:layout_height="match_parent"
            android:gravity="center"
            android:text="⌕"
            android:textSize="29sp"
            android:textColor="#9A9DA3"
            android:contentDescription="Pesquisar" />

        <EditText
            android:id="@+id/edtBuscaCategoria"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:hint="Buscar categoria ou peça..."
            android:inputType="text"
            android:imeOptions="actionSearch"
            android:singleLine="true"
            android:textColor="#FFFFFF"
            android:textColorHint="#777B83"
            android:textSize="14sp"
            android:paddingStart="8dp"
            android:paddingEnd="4dp" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="14dp"
        android:fillViewport="false"
        android:clipToPadding="false"
        android:scrollbars="vertical">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingBottom="20dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="142dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="18dp"
                android:background="@drawable/bg_categories_hero">
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="RCAR PREMIUM  •  CATÁLOGO"
                        android:textColor="#FF8A18"
                        android:textSize="9sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.08" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="7dp"
                        android:text="Encontre a peça\nideal para seu carro"
                        android:textColor="#FFFFFF"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:lineSpacingExtra="1dp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="Qualidade, confiança e praticidade em um só lugar."
                        android:textColor="#B6B8BD"
                        android:textSize="11sp"
                        android:maxLines="2" />
                </LinearLayout>

                <TextView
                    android:layout_width="68dp"
                    android:layout_height="76dp"
                    android:layout_marginStart="8dp"
                    android:gravity="center"
                    android:text="🚘"
                    android:textSize="36sp"
                    android:background="@drawable/bg_category_icon"
                    android:contentDescription="Automóvel" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:layout_marginBottom="13dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Explore por categoria"
                        android:textColor="#FFFFFF"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="Escolha uma área para continuar"
                        android:textColor="#898D94"
                        android:textSize="11sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/txtTotalCategorias"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingStart="10dp"
                    android:paddingTop="6dp"
                    android:paddingEnd="10dp"
                    android:paddingBottom="6dp"
                    android:text="10 categorias"
                    android:textColor="#FF982B"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:background="@drawable/bg_category_count" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/listaCategorias"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:text="RCAR PREMIUM  •  PEÇAS E ACESSÓRIOS AUTOMOTIVOS"
                android:textColor="#565A61"
                android:textSize="9sp"
                android:letterSpacing="0.04" />
        </LinearLayout>
    </ScrollView>

    <include
        layout="@layout/bottom_nav" />
</LinearLayout>
